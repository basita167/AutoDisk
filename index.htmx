<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AutoDisk</title>

<script src="https://unpkg.com/htmx.org@2.0.4"></script>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg: #08090b;
    --card: #111318;
    --text: #f4f4f5;
    --muted: #92959d;
    --line: #252830;
    --accent: #00f5c8;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Inter, sans-serif;
    background: var(--bg);
    color: var(--text);
}

/* NAV */

nav {
    height: 74px;
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 7%;
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(8,9,11,.94);
    backdrop-filter: blur(15px);
}

.logo {
    font-size: 25px;
    font-weight: 900;
    letter-spacing: -1px;
}

.logo span {
    color: var(--accent);
}

nav ul {
    display: flex;
    gap: 32px;
    list-style: none;
}

nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
}

nav a:hover {
    color: white;
}


/* MAIN */

#app {
    min-height: calc(100vh - 74px);
}


/* HERO */

.hero {
    min-height: 610px;
    padding: 90px 7%;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
    align-items: center;
    background:
        radial-gradient(circle at 80% 40%, #22261a 0, transparent 38%);
}

.hero-tag {
    color: var(--accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 3px;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(48px, 7vw, 92px);
    line-height: .92;
    letter-spacing: -5px;
}

.hero h1 span {
    color: var(--accent);
}

.hero p {
    color: var(--muted);
    max-width: 520px;
    line-height: 1.7;
    margin: 28px 0;
}

.hero-btn {
    display: inline-block;
    background: var(--accent);
    color: #08090b;
    padding: 15px 23px;
    border-radius: 4px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 900;
}


/* FEATURED */

.featured {
    position: relative;
}

.featured img {
    width: 100%;
    height: 390px;
    object-fit: cover;
    border-radius: 1px;
}

.feature-info {
    position: absolute;
    bottom: 22px;
    left: 22px;
    right: 22px;
    background: rgba(8,9,11,.82);
    backdrop-filter: blur(10px);
    padding: 20px;
    border: 1px solid #ffffff18;
}

.feature-info small {
    color: var(--accent);
    font-weight: 700;
}

.feature-info h2 {
    margin-top: 5px;
    font-size: 25px;
}


/* STATS */

.stats {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
}

.stat {
    padding: 40px 20px;
    text-align: center;
    border-right: 1px solid var(--line);
}

.stat:last-child {
    border-right: none;
}

.stat strong {
    display: block;
    font-size: 32px;
}

.stat span {
    color: var(--muted);
    font-size: 11px;
}


/* SECTION */

.section {
    padding: 90px 7%;
}

.section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 35px;
}

.section-head h2 {
    font-size: 40px;
    letter-spacing: -2px;
}

.section-head p {
    color: var(--muted);
    font-size: 14px;
}


/* SEARCH */

.search {
    width: 100%;
    background: var(--card);
    border: 1px solid var(--line);
    color: white;
    padding: 16px;
    border-radius: 4px;
    outline: none;
    margin-bottom: 25px;
    font-size: 14px;
}

.search:focus {
    border-color: var(--accent);
}


/* FILTERS */
.filters {
    display: flex;
    gap: 10px;
    margin-bottom: 35px;
}

.filters button {
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    padding: 11px 18px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 700;
}

.filters button:hover,
.filters button.active {
    background: var(--accent);
    color: #08090b;
    border-color: var(--accent);
}


/* VEHICLE GRID */

.vehicle-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.vehicle {
    background: var(--card);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: .25s;
}

.vehicle:hover {
    transform: translateY(-5px);
    border-color: #4a4d55;
}

.vehicle-img {
    position: relative;
}

.vehicle-img img {
    width: 100%;
    height: 230px;
    object-fit: cover;
    display: block;
}

.vehicle-type {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(0,0,0,.75);
    padding: 6px 10px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
}

.vehicle-body {
    padding: 20px;
}

.vehicle-body h3 {
    font-size: 21px;
}

.vehicle-body p {
    color: var(--muted);
    font-size: 12px;
    margin-top: 5px;
}

.specs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    margin-top: 18px;
    padding-top: 15px;
}

.spec {
    color: var(--muted);
    font-size: 10px;
}

.spec strong {
    display: block;
    color: white;
    font-size: 12px;
    margin-top: 4px;
}

.vehicle-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
}

.price {
    font-size: 17px;
    font-weight: 800;
}

.details {
    color: var(--accent);
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
    text-decoration: none;
}


/* ABOUT */

.about {
    padding: 40px 7% 100px;
}

.about p {
    max-width: 700px;
    color: var(--muted);
    line-height: 1.8;
}


/* VEHICLE DETAIL PAGE */

.detail-page {
    min-height: calc(100vh - 74px);
    padding: 40px 7% 100px;
}


/* BACK BUTTON */

.back-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--muted);
    padding: 12px 18px;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    margin-bottom: 40px;
    transition: .2s;
}

.back-button:hover {
    color: #08090b;
    background: var(--accent);
    border-color: var(--accent);
}


/* DETAIL HERO */

.detail-hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
}

.detail-image {
    width: 100%;
    height: 520px;
    object-fit: cover;
    border-radius: 6px;
}

.detail-label {
    color: var(--accent);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 3px;
    margin-bottom: 15px;
}

.detail-info h1 {
    font-size: clamp(45px, 6vw, 80px);
    line-height: .95;
    letter-spacing: -4px;
    margin-bottom: 20px;
}

.detail-description {
    color: var(--muted);
    line-height: 1.8;
    max-width: 500px;
    margin-bottom: 35px;
}


/* DETAIL SPECS */

.detail-specs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
}

.detail-spec {
    padding: 22px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
}

.detail-spec span {
    color: var(--muted);
    display: block;
    font-size: 10px;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.detail-spec strong {
    font-size: 18px;
}

.detail-price {
    font-size: 30px;
    font-weight: 900;
    margin-top: 30px;
}


/* FOOTER */

footer {
    padding: 55px 7%;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-size: 12px;
}

footer strong {
    color: white;
}


/* RESPONSIVE */

@media(max-width: 900px) {

    .hero {
        grid-template-columns: 1fr;
    }

    .detail-hero {
        grid-template-columns: 1fr;
    }

    .vehicle-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .detail-image {
        height: 400px;
    }
}


@media(max-width: 600px) {

    nav ul {
        display: none;
    }

    .hero {
        padding-top: 60px;
    }

    .vehicle-grid {
        grid-template-columns: 1fr;
    }

    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .stat:nth-child(2) {
        border-right: none;
    }

    .section-head {
        display: block;
    }

    .section-head p {
        margin-top: 10px;
    }

    .detail-image {
        height: 300px;
    }

    footer {
        flex-direction: column;
        gap: 15px;
    }
}


.detail-discussion {
    margin-top: 70px;
    max-width: 850px;
    border-top: 1px solid var(--line);
    padding-top: 45px;
}

.detail-discussion h2 {
    font-size: 38px;
    letter-spacing: -2px;
    margin-bottom: 25px;
}

.detail-discussion p {
    color: var(--muted);
    line-height: 1.9;
    font-size: 15px;
    margin-bottom: 22px;
}
</style>

</head>

<body>

<nav>


<div class="logo">
    Auto<span>Disk</span>
</div>

<ul>
