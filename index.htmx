function showHome() {

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

    document.getElementById("app").innerHTML = `

        <section class="hero" id="home">

            <div>

                <div class="hero-tag">
                    AUTOMOTIVE COLLECTION / 2026
                </div>

                <h1>
                    MACHINES<br>
                    THAT <span>ARE EXOTIC!</span>
                </h1>

                <p>
                    Explore a curated collection of performance cars,
                    legendary motorcycles and modern machines built
                    for people who love the luxary to ride along on a royal ride.
                </p>

                <a href="#vehicles" class="hero-btn">
                    EXPLORE COLLECTION →
                </a>

            </div>


            <div class="featured">

                <img src="${vehicles[0].image}">

                <div class="feature-info">

                    <small>FEATURED MACHINE</small>

                    <h2>
                        ${vehicles[0].name}
                    </h2>

                </div>

            </div>

        </section>




        <div class="stats">

            <div class="stat">
                <strong>${vehicles.length}</strong>
                <span>VEHICLES</span>
            </div>

            <div class="stat">
                <strong>${vehicles.filter(v => v.type === "car").length}</strong>
                <span>CARS</span>
            </div>

            <div class="stat">
                <strong>${vehicles.filter(v => v.type === "bike").length}</strong>
                <span>BIKES</span>
            </div>
            <div class="stat">
            
            <strong>${vehicles.filter(v => v.type === "truck").length}</strong>
				<span>TRUCKS</span>
			</div>
            
            <div class="stat">
                <strong>14</strong>
                <span>BRANDS</span>
            </div>

        </div>



        <section class="section" id="vehicles">

            <div class="section-head">

                <div>
                    <div class="hero-tag">
                        THE COLLECTION
                    </div>

                    <h2>
                        Choose Your Machine
                    </h2>
                </div>

                <p>
                    Performance. Design. Engineering.
                </p>

            </div>


            <input
                class="search"
                type="text"
                placeholder="Search vehicles..."
                oninput="searchVehicles(this.value)"
            >
			<div class="filters">
				<button class="active" onclick="filterVehicles('all', this)">
					ALL
				</button>
				<button onclick="filterVehicles('car', this)">
					CARS
				</button>
				<button onclick="filterVehicles('bike', this)">
					BIKES
				</button>
				<button onclick="filterVehicles('truck', this)">
					TRUCKS & PICKUPS
				</button>
			</div>
            <div class="vehicle-grid" id="vehicleGrid">

                ${renderVehicles(vehicles)}

            </div>

        </section>


        <section class="about" id="about">

            <div class="hero-tag">
                ABOUT DRIVE
            </div>

            <h2 style="font-size:40px;margin-bottom:20px;">
                Built Around Machines
            </h2>

            <p>
                DRIVE is a digital showcase for machines that deserve
                attention. From precision German engineering to raw
                American muscle and screaming Italian superbikes,
                discover the machines that define automotive culture.
            </p>

        </section>


        <footer>

            <div>
                <strong>AutoDisk.</strong> — automobiles infoHoard
            </div>

            <div>
                © 2026 AutoDisk
            </div>

        </footer>
    `;
}


/*
    VEHICLE CARDS
*/

function renderVehicles(list) {

    return list.map(vehicle => `

        <article class="vehicle">

            <div class="vehicle-img">

                <img src="${vehicle.image}">

                <span class="vehicle-type">
                    ${vehicle.category}
                </span>

            </div>


            <div class="vehicle-body">

                <h3>
                    ${vehicle.name}
                </h3>

                <p>
                    ${vehicle.description}
                </p>


                <div class="specs">

                    <div class="spec">
                        ENGINE
                        <strong>${vehicle.engine}</strong>
                    </div>

                    <div class="spec">
                        POWER
                        <strong>${vehicle.power}</strong>
                    </div>

                    <div class="spec">
                        0–100
                        <strong>${vehicle.acceleration}</strong>
                    </div>

                </div>


                <div class="vehicle-footer">

                    <span class="price">
                        ${vehicle.price}
                    </span>

                    <a
                        class="details"
                        onclick="showVehicle(${vehicle.id})"
                    >
                        VIEW →
                    </a>

                </div>

            </div>

        </article>

    `).join("");

}


/*
    FILTERING
*/

function filterVehicles(type, button) {

    document.querySelectorAll(".filters button")
        .forEach(btn => btn.classList.remove("active"));

    button.classList.add("active");

    const filtered = type === "all"
        ? vehicles
        : vehicles.filter(vehicle => vehicle.type === type);

    document.getElementById("vehicleGrid").innerHTML =
        renderVehicles(filtered);

}


/*
    SEARCH
*/

function searchVehicles(value) {

    value = value.toLowerCase();

    const filtered = vehicles.filter(vehicle =>
        vehicle.name.toLowerCase().includes(value) ||
        vehicle.category.toLowerCase().includes(value)
    );

    document.getElementById("vehicleGrid").innerHTML =
        renderVehicles(filtered);

}


/*
    VEHICLE INFO COMPONENT
*/

function showVehicle(id) {

    const vehicle = vehicles.find(v => v.id === id);

    if (!vehicle) return;

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });


    document.getElementById("app").innerHTML = `

        <section class="detail-page">

            <button
                class="back-button"
                onclick="showHome()"
            >
                ← BACK TO COLLECTION
            </button>


            <div class="detail-hero">


                <div>

                    <img
                        class="detail-image"
                        src="${vehicle.image}"
                    >

                </div>


                <div class="detail-info">

                    <div class="detail-label">
                        ${vehicle.category}
                    </div>

                    <h1>
                        ${vehicle.name}
                    </h1>

                    <div class="detail-discussion">

    <div class="detail-label">
        ABOUT THE MACHINE
    </div>

    ${vehicleDiscussions[vehicle.id].discussion
        .trim()
        .split(/\n\s*\n/)
        .map(paragraph => `<p>${paragraph.trim()}</p>`)
        .join("")
    }

</div>

                    <div class="detail-specs">

                        <div class="detail-spec">
                            <span>ENGINE</span>
                            <strong>${vehicle.engine}</strong>
                        </div>

                        <div class="detail-spec">
                            <span>POWER</span>
                            <strong>${vehicle.power}</strong>
                        </div>

                        <div class="detail-spec">
                            <span>0–100 KM/H</span>
                            <strong>${vehicle.acceleration}</strong>
                        </div>

                        <div class="detail-spec">
                            <span>TOP SPEED</span>
                            <strong>${vehicle.topSpeed}</strong>
                        </div>

                        <div class="detail-spec">
                            <span>TRANSMISSION</span>
                            <strong>${vehicle.transmission}</strong>
                        </div>

                        <div class="detail-spec">
                            <span>DRIVETRAIN</span>
                            <strong>${vehicle.drivetrain}</strong>
                        </div>

                    </div>


                    <div class="detail-price">
                        ${vehicle.price}
                    </div>

                </div>

            </div>

        </section>


        <footer>

            <div>
                <strong>AutoDisk.</strong> — automobiles infoHoard
            </div>

            <div>
                © 2026 AutoDisk
            </div>

        </footer>

    `;

}


/*
    INITIAL PAGE
*/

showHome();

</script>

</body>
</html>
